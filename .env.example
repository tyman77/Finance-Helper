# Copy to .env and fill in. .env is gitignored.

# --- Web UI login (Sign in with Google) ---
# Required if you host the web UI anywhere other than your own machine (it can
# post real journal entries to Sage, so it must not be reachable by anyone
# without logging in). Leave all three blank to keep running with no login,
# for localhost-only use.
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Application type: Web application).
# Add your deployed URL + /auth/google/callback as an Authorized redirect URI
# (e.g. https://your-app.up.railway.app/auth/google/callback).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only Google accounts on this Workspace domain can log in — required
# whenever the client ID/secret above are set, so a stray Gmail account can't
# get in. e.g. summitintegrated.com
GOOGLE_OAUTH_ALLOWED_DOMAIN=
# Random session-signing key — required whenever Google login is configured
# (the app refuses to start otherwise, since a login without a real secret can
# be bypassed by forging the session cookie). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FINANCE_HELPER_SECRET=

# --- Storage locations ---
# Only needed on a hosted deployment (e.g. Railway) to point these at a
# persistent volume instead of the default relative ./data and ./out, which
# live in the container's ephemeral filesystem and get wiped on redeploy.
FINANCE_HELPER_DATA=
FINANCE_HELPER_OUT_DIR=

# --- Admin panel (/admin) — regenerating data/*.json on the server ---
# The traveler map, project registry, and chart of accounts are rebuilt from
# a CSV you upload through the admin page itself — no env vars needed for
# those. The crew-schedule and calendar refreshes need Google credentials;
# the same service account used for local scripts/fetch_*.py, but supplied
# as the JSON key's *content* (not a file path — there's no local disk to
# point at on a host like Railway). Paste the whole key file's contents:
GOOGLE_SERVICE_ACCOUNT_JSON=
# The crew-schedule Google Sheet (see README's "Auto-coding the project" section).
SCHEDULE_SHEET_ID=
SCHEDULE_SHEET_RANGE='2026'!A1:NZ1008
# Set to 1 only if you've set up domain-wide delegation so the service
# account can read each traveler's own calendar; leave unset if each
# calendar was individually shared with the service account instead.
USE_DWD=

# --- Bill Check (AP entry review) ---
# Reads the invoice attached to each unpaid Bill.com bill with Claude and
# compares it with what the clerk entered. Needs the BILLDOTCOM_* credentials
# below AND an Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=
# Model used to read attachments (default claude-opus-5); BILLCHECK_EFFORT
# (default medium) trades read depth for cost. Attachments read per run cap
# (default 200) — unchanged bills are never re-read, so this only bounds new
# bills per click.
BILLCHECK_MODEL=
BILLCHECK_EFFORT=
BILLCHECK_MAX_READS_PER_RUN=
# Only if your org's classic API exposes attachments under a different call
# than GetDocumentPages.json (the error on the bill page shows the raw reply).
BILLDOTCOM_DOC_PAGES_PATH=

# --- Sage Intacct (REST API, OAuth2 client-credentials grant) ---
# Register an app at https://developer.sage.com/intacct/ to get a Client ID
# and Secret, and create/authorize a Web Services User for it within your
# company (Company Console -> Web Services -> add authorized app).
# All five of these are required — confirmed live: the token request 400s
# with "Either username or session_id is required" without USER_ID/PASSWORD,
# so despite being a "client_credentials" grant, Sage still needs the Web
# Services User identified in the request (client_id/secret identify the
# app; username/password identify the authorized user within it).
INTACCT_CLIENT_ID=
INTACCT_CLIENT_SECRET=
INTACCT_COMPANY_ID=
INTACCT_USER_ID=
INTACCT_USER_PASSWORD=
# The GL account you credit to balance expense journal entries (e.g. AP or a clearing acct)
INTACCT_CLEARING_ACCOUNT=
# Cash Proof's GL-detail pull (recon/sage_api.py) reuses the same five
# credentials above. Optional overrides if Sage rejects the default
# query endpoint/object (see that module's docstring):
# INTACCT_GL_QUERY_URL=
# INTACCT_GL_OBJECT=

# XML gateway sender credentials (the same style the Apex/Shopify integration
# uses). When set, Cash Proof's Sage pull uses the XML gateway and the
# INTACCT_CLIENT_* pair above isn't needed for it. Company/user/password come
# from the shared INTACCT_COMPANY_ID / INTACCT_USER_ID / INTACCT_USER_PASSWORD.
INTACCT_SENDER_ID=
INTACCT_SENDER_PASSWORD=
# INTACCT_XML_URL=   # optional gateway override

# --- Ramp (developer API) ---
# Ramp -> Settings -> Developer API -> create app; scope reimbursements:read.
# Feeds the per-diem index that corroborates trips and tags flight projects.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# RAMP_API_URL=   # optional override

# --- Paychex Flex (timecards) ---
# API access is granted through Paychex's developer program (developer.paychex.com)
# and must be authorized for your company. The Admin page's timecard CSV upload
# works without any of this.
PAYCHEX_CLIENT_ID=
PAYCHEX_CLIENT_SECRET=
PAYCHEX_COMPANY_ID=
# PAYCHEX_API_URL=          # optional override
# PAYCHEX_TIMECARDS_URL=    # optional override for the timecards endpoint

# --- Bill.com (v3 API) ---
# Register at https://developer.bill.com/ to obtain these.
BILLDOTCOM_DEV_KEY=
BILLDOTCOM_USERNAME=
BILLDOTCOM_PASSWORD=
BILLDOTCOM_ORG_ID=
# Use the sandbox gateway until you're ready for production.
BILLDOTCOM_BASE_URL=https://gateway.stage.bill.com/connect/v3
