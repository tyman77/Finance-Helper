# Copy to .env and fill in. .env is gitignored.

# --- Sage Intacct (REST API, OAuth2 client-credentials grant) ---
# Register an app at https://developer.sage.com/intacct/ to get a Client ID
# and Secret, and create/authorize a Web Services User for it within your
# company (Company Console -> Web Services -> add authorized app).
# All five of these are required — confirmed live: the token request 400s
# with "Either username or session_id is required" without USER_ID/PASSWORD,
# so despite being a "client_credentials" grant, Sage still needs the Web
# Services User identified in the request (client_id/secret identify the
# app; username/password identify the authorized user within it).
INTACCT_CLIENT_ID=
INTACCT_CLIENT_SECRET=
INTACCT_COMPANY_ID=
INTACCT_USER_ID=
INTACCT_USER_PASSWORD=
# The GL account you credit to balance expense journal entries (e.g. AP or a clearing acct)
INTACCT_CLEARING_ACCOUNT=

# Legacy XML API sender credentials — only needed if you fall back to the XML
# API instead of REST; the REST/OAuth2 path above doesn't use these.
INTACCT_SENDER_ID=
INTACCT_SENDER_PASSWORD=

# --- Bill.com (v3 API) ---
# Register at https://developer.bill.com/ to obtain these.
BILLDOTCOM_DEV_KEY=
BILLDOTCOM_USERNAME=
BILLDOTCOM_PASSWORD=
BILLDOTCOM_ORG_ID=
# Use the sandbox gateway until you're ready for production.
BILLDOTCOM_BASE_URL=https://gateway.stage.bill.com/connect/v3
